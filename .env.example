# Facultatif : sans DATABASE_URL, PostgreSQL embarqué persiste dans .data/postgres.
# Copier ce fichier vers .env ou définir les variables dans le terminal.
# DATABASE_URL=postgres://prototype:prototype@127.0.0.1:5432/social
# Avec Neon Auth, neon deploy renseigne NEON_AUTH_BASE_URL et NEON_AUTH_JWKS_URL.
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Multiplicateur des gains à leur récolte, par exemple 2 lors d’un événement.
# XP_MULTIPLIER=1
# IRIS_ONLY=1
# Comptes VIP autorisés à importer un fond de profil (séparés par des virgules).
# PROFILE_IMAGE_VIP_ACCOUNTS=aurore

# Atelier d’import gratuit : tout le détourage est local, aucune clé nécessaire.
ATELIER_EDITOR_ACCOUNT=aurore
